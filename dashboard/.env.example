# Server-only Council credentials. Never expose with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Owner-only approval/dispatch gate. Reuse MCP_ACCESS_KEY or define COUNCIL_APPROVE_KEY.
MCP_ACCESS_KEY=YOUR_PRIVATE_APPROVAL_KEY
# COUNCIL_APPROVE_KEY=YOUR_PRIVATE_APPROVAL_KEY

# Dedicated machine-to-machine executor credential for target repository workflows.
# Use a different random secret from the owner approval key.
ADB_EXECUTOR_KEY=YOUR_PRIVATE_EXECUTOR_KEY

# Durable Memory: PostgreSQL is SSOT, Qdrant is the derived semantic index.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
QDRANT_URL=https://YOUR_QDRANT_HOST
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_VECTOR_SIZE=1536

# One-click coding dispatcher — server-only GitHub App credentials.
# Keep the private key in Vercel/Supabase secret storage; never commit the real PEM.
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
# Optional: GitHub now recommends the App client ID as JWT issuer when available.
# GITHUB_APP_CLIENT_ID=YOUR_GITHUB_APP_CLIENT_ID
GITHUB_APP_INSTALLATION_ID=YOUR_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Fail-closed repository allowlist. Comma-separated owner/repo entries only.
ADB_ALLOWED_REPOSITORIES=amirhamrouni/lessonss

# Optional public browser configuration used by other dashboard features.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_COUNCIL_CHANNEL=amir-dev-brain:council
