# Server-only Council credentials. Never expose with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Owner-only approval gate. Reuse MCP_ACCESS_KEY or define COUNCIL_APPROVE_KEY.
MCP_ACCESS_KEY=YOUR_PRIVATE_APPROVAL_KEY
# COUNCIL_APPROVE_KEY=YOUR_PRIVATE_APPROVAL_KEY

# Durable Memory: PostgreSQL is SSOT, Qdrant is the derived semantic index.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
QDRANT_URL=https://YOUR_QDRANT_HOST
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_VECTOR_SIZE=1536

# Optional public browser configuration used by other dashboard features.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_COUNCIL_CHANNEL=amir-dev-brain:council
