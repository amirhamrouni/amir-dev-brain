{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amir.dev.brain/schemas/decision.schema.json",
  "title": "Amir Dev Brain Decision",
  "description": "Auditable decision contract. A version change may stale evidence without automatically invalidating the decision itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "revision",
    "project",
    "title",
    "statement",
    "state",
    "authority",
    "created_at",
    "review_policy",
    "version_bindings",
    "evidence_links"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$",
      "examples": ["ADB-002", "ET-001"]
    },
    "revision": { "type": "integer", "minimum": 1, "default": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "statement": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "default": "" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "excludes": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "default": { "includes": [], "excludes": [] }
    },
    "state": {
      "type": "string",
      "enum": ["ACTIVE", "REVIEW_DUE", "EVIDENCE_STALE", "REVALIDATING", "SUPERSEDED", "REVOKED"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "approval_mode"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_mode": {
          "type": "string",
          "enum": ["OWNER_APPROVAL", "OWNER_AFTER_COUNCIL", "EXECUTIVE_OVERRIDE", "MIGRATED_LEGACY"]
        },
        "approval_ref": { "type": ["string", "null"], "default": null }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$" },
      "uniqueItems": true,
      "default": []
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$",
      "default": null
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_days", "triggers"],
      "properties": {
        "review_after": { "type": ["string", "null"], "format": "date-time", "default": null },
        "max_age_days": { "type": ["integer", "null"], "minimum": 1, "default": 90 },
        "triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "dependency_change",
              "security_finding",
              "policy_change",
              "tool_major_change",
              "tool_minor_change",
              "environment_change",
              "evidence_invalidated",
              "implementation_change",
              "manual_review"
            ]
          },
          "default": ["dependency_change", "security_finding", "policy_change", "tool_major_change", "evidence_invalidated"]
        }
      }
    },
    "version_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "kind", "observed_version", "binding_mode"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["DEPENDENCY", "TOOL", "POLICY", "RUNTIME", "WORKFLOW", "MODEL", "SCANNER", "SCHEMA"]
          },
          "observed_version": { "type": "string", "minLength": 1 },
          "version_constraint": { "type": ["string", "null"], "default": null },
          "binding_mode": {
            "type": "string",
            "enum": ["EVIDENCE_VALIDATION", "PINNED_REQUIREMENT", "INFORMATIONAL"]
          },
          "source": { "type": ["string", "null"], "default": null },
          "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{7,40}$", "default": null },
          "policy_id": { "type": ["string", "null"], "default": null }
        }
      },
      "default": []
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "relation", "status", "captured_at", "locator"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "enum": ["SUPPORTS", "CONTRADICTS", "CONTEXT", "REVALIDATES"] },
          "status": { "type": "string", "enum": ["VALID", "POTENTIALLY_STALE", "STALE", "REVALIDATING", "INVALID"] },
          "captured_at": { "type": "string", "format": "date-time" },
          "locator": { "type": "string", "minLength": 1 },
          "content_hash": { "type": ["string", "null"], "default": null },
          "summary": { "type": ["string", "null"], "default": null },
          "bound_components": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "default": []
          }
        }
      },
      "default": []
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_checked_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "last_result": {
          "type": ["string", "null"],
          "enum": ["SYNCED", "MINOR_DRIFT", "SIGNIFICANT_DRIFT", null],
          "default": null
        },
        "pending_reasons": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "default": { "last_checked_at": null, "last_result": null, "pending_reasons": [] }
    },
    "alternatives_rejected": { "type": "array", "items": { "type": "string" }, "default": [] },
    "risks": { "type": "array", "items": { "type": "string" }, "default": [] },
    "action_items": { "type": "array", "items": { "type": "string" }, "default": [] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "SUPERSEDED" } }, "required": ["state"] },
      "then": { "required": ["superseded_by"], "properties": { "superseded_by": { "type": "string" } } }
    }
  ]
}
